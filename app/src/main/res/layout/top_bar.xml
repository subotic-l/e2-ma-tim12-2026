<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="#66C4FF"
    android:elevation="4dp">

    <!-- Token + Star Section (left side) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/topBarTokenCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_token"
            android:contentDescription="Tokeni" />

        <TextView
            android:id="@+id/topBarStarCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="2dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_star"
            android:contentDescription="Zvezde" />
    </LinearLayout>

    <!-- League Section (right side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/topBarLeagueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mrav"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/topBarLeagueIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ant"
            android:contentDescription="Liga" />
    </LinearLayout>
</LinearLayout>