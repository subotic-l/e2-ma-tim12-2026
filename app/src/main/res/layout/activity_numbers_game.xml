<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#529dcc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="-41dp"
        tools:layout_editor_absoluteY="0dp">

        <include layout="@layout/top_bar" />

        <include layout="@layout/player_score_row" />

        <TextView
            android:id="@+id/gameTimerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="60"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Target number card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/button_default_color"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/button_default_border"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/targetTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="140dp"
                android:padding="16dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Expression display card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/button_selected_color"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/button_default_border"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/expressionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:padding="12dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Number buttons – 2 rows of 3 -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:alignmentMode="alignMargins"
            app:columnCount="3"
            app:rowCount="2"
            app:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/button_default_color"
                android:elevation="8dp"
                android:minHeight="60dp"
                android:text="@string/question_mark"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:layout_columnWeight="1"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- Operator buttons row -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:alignmentMode="alignMargins"
            app:columnCount="6"
            app:rowCount="1"
            app:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_paren_left"
                app:iconGravity="textTop"
                android:text="("
                android:textSize="0sp"
                app:iconPadding="0dp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_paren_right"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                android:text=")"
                android:textSize="0sp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_add"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                android:text="+"
                android:textSize="0sp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_minus"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                android:text="-"
                android:textSize="0sp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_multiply"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                android:text="*"
                android:textSize="0sp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="4dp"

                app:layout_columnWeight="1"
                app:layout_rowWeight="1"

                app:icon="@drawable/ic_divide"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                android:text="/"
                android:textSize="0sp"

                android:gravity="center"

                android:backgroundTint="@color/button_selected_color"
                android:elevation="8dp"

                app:cornerRadius="12dp"
                app:strokeColor="@color/button_selected_border"
                app:strokeWidth="2dp" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- Control row: POTVRDI, X, STOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/correct_answer_color"
                android:elevation="8dp"
                android:text="POTVRDI"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/correct_answer_border"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/wrong_answer_color"
                android:elevation="8dp"
                android:text="OBRIŠI"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/wrong_answer_border"
                app:strokeWidth="2dp" />

        </LinearLayout>

        <!-- STOP countdown timer row -->
        <LinearLayout
            android:id="@+id/stopTimerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOP za: "
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stopTimerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/button_default_color"
            android:elevation="8dp"
            android:text="STOP"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/button_default_border"
            app:strokeWidth="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
