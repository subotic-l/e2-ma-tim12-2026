<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#529dcc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/top_bar" />

        <!-- STOP countdown timer row -->
        <LinearLayout
            android:id="@+id/stopTimerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOP za: "
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stopTimerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Target number card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/button_default_border"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/button_default_color">

            <TextView
                android:id="@+id/targetTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:padding="16dp"
                android:text="@string/question_mark"
                android:textSize="40sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Expression display card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/button_default_border"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/button_selected_color">

            <TextView
                android:id="@+id/expressionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:padding="12dp"
                android:text=""
                android:textSize="22sp"
                android:textColor="@color/white"
                android:gravity="center_vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Number buttons – 2 rows of 3 -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:columnCount="3"
            app:rowCount="2"
            app:alignmentMode="alignMargins"
            app:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/numButton6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="60dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="@string/question_mark" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- Operator buttons row -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:columnCount="6"
            app:rowCount="1"
            app:alignmentMode="alignMargins"
            app:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text="(" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text=")" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text="+" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text="-" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text="*" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                android:minHeight="52dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_selected_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_selected_border"
                android:text="÷" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- Control row: POTVRDI, X, STOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/correct_answer_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/correct_answer_border"
                android:text="POTVRDI"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/wrong_answer_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/wrong_answer_border"
                android:text="X"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeWidth="2dp"
                app:strokeColor="@color/button_default_border"
                android:text="STOP"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>