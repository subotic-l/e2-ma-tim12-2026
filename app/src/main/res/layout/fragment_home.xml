<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/button_default_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tokeni"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textTokenCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFD700"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/buttonStartMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Igraj partiju (lokalno)"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonOnlineMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Igraj online"
            android:backgroundTint="#4CAF50"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonTournament"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Igraj turnir"
            android:backgroundTint="#FF9800"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartWhoKnows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Ko zna zna"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartMatchingGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Spojnice"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartStepByStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Korak po korak"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartNumbersGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Moj broj"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartSkocko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Skocko"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonStartAsocijacije"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Pokreni Asocijacije"
            android:backgroundTint="@color/button_default_color"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
