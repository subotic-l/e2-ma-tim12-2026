<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/welcome_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Slagalica"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"
        android:textColor="@color/button_default_color"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ulogujte se"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp"

        android:backgroundTint="@color/button_default_color"
        app:strokeColor="@color/button_default_border"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        android:elevation="6dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrujte se"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp"

        android:backgroundTint="@color/button_selected_color"
        app:strokeColor="@color/button_selected_border"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        android:elevation="6dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_guest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nastavite kao gost"
        android:textColor="@color/white"

        android:backgroundTint="@color/correct_answer_color"
        app:strokeColor="@color/correct_answer_border"
        app:strokeWidth="2dp"
        app:cornerRadius="12dp"
        android:elevation="6dp"/>

</LinearLayout>