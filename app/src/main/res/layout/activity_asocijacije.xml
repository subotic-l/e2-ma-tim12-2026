<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#529DCC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/top_bar" />

        <include layout="@layout/player_score_row" />

        <LinearLayout
            android:id="@+id/instructionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/instructionsTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="4dp"/>

            <Button
                android:id="@+id/skipButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Preskoči"
                android:textSize="12sp"
                android:visibility="gone"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:padding="4dp">

                        <Button android:id="@+id/a1" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="A1" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/a2" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="A2" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/a3" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="A3" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/a4" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="A4" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/btnA" android:layout_width="match_parent"
                            android:layout_height="50dp" android:text="A" android:textSize="18sp"
                            android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:padding="4dp">

                        <Button android:id="@+id/b1" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="B1" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/b2" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="B2" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/b3" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="B3" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/b4" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="B4" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/btnB" android:layout_width="match_parent"
                            android:layout_height="50dp" android:text="B" android:textSize="18sp"
                            android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnFinal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="KONAČNO"
                    android:textSize="22sp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="2">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:padding="4dp">

                        <Button android:id="@+id/btnC" android:layout_width="match_parent"
                            android:layout_height="50dp" android:text="C" android:textSize="18sp"
                            android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:textStyle="bold"
                            android:layout_marginTop="4dp"/>

                        <Button android:id="@+id/c1" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="C1" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/c2" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="C2" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/c3" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="C3" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/c4" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="C4" android:textStyle="bold" android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:padding="4dp">

                        <Button android:id="@+id/btnD" android:layout_width="match_parent"
                            android:layout_height="50dp" android:text="D" android:textSize="18sp"
                            android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:textStyle="bold"
                            android:layout_marginTop="4dp"/>

                        <Button android:id="@+id/d1" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="D1" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/d2" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="D2" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/d3" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="D3" android:textStyle="bold" android:textSize="13sp"/>

                        <Button android:id="@+id/d4" android:layout_width="match_parent" android:layout_height="50dp"
                            android:layout_margin="2dp" android:backgroundTint="#0277BD" android:textColor="#FFFFFF"
                            android:text="D4" android:textStyle="bold" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
