<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#529DCC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/top_bar" />

        <include layout="@layout/player_score_row" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/instructionsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Priprema..."
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="4dp"/>

            <LinearLayout
                android:id="@+id/solutionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#2C5F7A">

                <ImageView
                    android:id="@+id/sol0"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/cell_background"/>

                <ImageView
                    android:id="@+id/sol1"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/cell_background"/>

                <ImageView
                    android:id="@+id/sol2"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/cell_background"/>

                <ImageView
                    android:id="@+id/sol3"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/cell_background"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/gameContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
            </ScrollView>

            <!-- IZBOR SIMBOLA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp"
                android:background="#2C5F7A">

                <ImageButton
                    android:id="@+id/btnSkocko"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_skocko"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>

                <ImageButton
                    android:id="@+id/btnTref"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_tref"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>

                <ImageButton
                    android:id="@+id/btnKaro"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_karo"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>

                <ImageButton
                    android:id="@+id/btnPik"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_pik"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>

                <ImageButton
                    android:id="@+id/btnHerc"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_herc"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>

                <ImageButton
                    android:id="@+id/btnZvezda"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_zvezda"
                    android:background="@drawable/btn_symbol_bg"
                    android:scaleType="centerInside"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
