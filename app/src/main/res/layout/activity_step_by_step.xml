<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#529dcc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/top_bar" />

        <include layout="@layout/player_score_row_local" />

        <!-- Points + Timer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/pointsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Bodovi: 20"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/timerTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Vreme: 10"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 7 Clue Cards - filling remaining space evenly -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/button_default_color">

                <TextView
                    android:id="@+id/clue7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:text="(zatvoreno)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:gravity="center_vertical" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Guess Input row at bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/guessInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Unesite pojam"
                    android:textColor="@color/white"
                    android:imeOptions="actionDone"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitGuessButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Potvrdi"
                android:textColor="@color/white"
                android:backgroundTint="@color/button_default_color"
                app:strokeColor="@color/button_default_border"
                app:strokeWidth="2dp"
                app:cornerRadius="12dp"
                android:elevation="8dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
